# ========================================================
# ProofLens AI — Environment Configuration Template
# ========================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prooflens_ai

# File Storage Configuration
STORAGE_ROOT=storage/uploads
MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENTS_PER_WORKSPACE=10

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# RAG & Evidence Thresholds
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.65
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
